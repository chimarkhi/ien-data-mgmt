# Copy this file to .env and fill in values for local development.
# In Google Colab, add these as Secrets (key icon in sidebar) instead.

# PostgreSQL connection string for the birdnet database
IEN_DB_URL=postgresql://birdnet:<password>@<host>:5432/birdnet

# Zenodo personal access token (https://zenodo.org/account/settings/applications/)
IEN_ZENODO_TOKEN=<your_zenodo_token>
